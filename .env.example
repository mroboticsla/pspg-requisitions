# Supabase
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Database (scripts: create-job-ads-tables, create-contact-requests-table, add-contact-read-policy)
POSTGRES_URL="postgres://postgres.your-project:password@aws-1-us-east-1.pooler.supabase.com:6543/postgres?sslmode=require"

# Site
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Coming Soon Mode - Cambia a "true" para activar la página de "Próximamente"
NEXT_PUBLIC_ENABLE_COMING_SOON="false"

# Site Access Key - Clave para acceder al sitio cuando Coming Soon está activo
# Accede con: /?access=dev (o la clave que configures aquí)
SITE_ACCESS_KEY="dev"

# Admin API - header x-admin-secret debe coincidir con este valor
ADMIN_SECRET="your-admin-secret"
